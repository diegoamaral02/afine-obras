rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Fotos de manutenções ────────────────────────────────────────────
    match /fotos/manutencoes/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Fotos de obras ──────────────────────────────────────────────────
    match /fotos/obras/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Fotos de escopos (estrutura legada) ────────────────────────────
    match /obras/{obraId}/escopos/{escopoId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── OS (Ordens de Serviço): imagem ou PDF ──────────────────────────
    match /obras/{obraId}/os/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
  }
}
